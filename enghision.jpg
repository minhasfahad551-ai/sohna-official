</span><span class="text-codex-syntax-attribute">.price-card </span><span>{
    </span><span class="text-codex-syntax-attribute">background</span><span>: </span><span class="text-codex-syntax-literal">white</span><span>;
    </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">25px 20px</span><span>;
    </span><span class="text-codex-syntax-attribute">border-radius</span><span>: </span><span class="text-codex-syntax-literal">10px</span><span>;
    </span><span class="text-codex-syntax-attribute">border-bottom</span><span>: </span><span class="text-codex-syntax-literal">4px solid </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--gold</span><span>);
    </span><span class="text-codex-syntax-attribute">box-shadow</span><span>: </span><span class="text-codex-syntax-literal">0 5px 20px </span><span class="text-codex-syntax-variable">rgba</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>,</span><span class="text-codex-syntax-literal">0</span><span>,</span><span class="text-codex-syntax-literal">0</span><span>,</span><span class="text-codex-syntax-literal">0.06</span><span>);
    </span><span class="text-codex-syntax-attribute">transition</span><span>: </span><span class="text-codex-syntax-literal">0.3s</span><span>;
}

</span><span class="text-codex-syntax-attribute">.price-card:hover </span><span>{
    </span><span class="text-codex-syntax-attribute">transform</span><span>: </span><span class="text-codex-syntax-variable">translateY</span><span>(</span><span class="text-codex-syntax-literal">-5px</span><span>);
    </span><span class="text-codex-syntax-attribute">border-bottom-color</span><span>: </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--red</span><span>);
}

</span><span class="text-codex-syntax-attribute">.price-card </span><span class="text-codex-syntax-name">h3 </span><span>{
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--red</span><span>);
    </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">19px</span><span>;
    </span><span class="text-codex-syntax-attribute">margin-bottom</span><span>: </span><span class="text-codex-syntax-literal">15px</span><span>;
    </span><span class="text-codex-syntax-attribute">padding-bottom</span><span>: </span><span class="text-codex-syntax-literal">10px</span><span>;
    </span><span class="text-codex-syntax-attribute">border-bottom</span><span>: </span><span class="text-codex-syntax-literal">1px solid </span><span class="text-codex-syntax-string">#eeeeee</span><span>;
}

</span><span class="text-codex-syntax-attribute">.price-card </span><span class="text-codex-syntax-name">p </span><span>{
    </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">flex</span><span>;
    </span><span class="text-codex-syntax-attribute">justify-content</span><span>: </span><span class="text-codex-syntax-literal">space-between</span><span>;
    </span><span class="text-codex-syntax-attribute">align-items</span><span>: </span><span class="text-codex-syntax-literal">flex-start</span><span>;
    </span><span class="text-codex-syntax-attribute">gap</span><span>: </span><span class="text-codex-syntax-literal">10px</span><span>;
    </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">14px</span><span>;
    </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">9px 0</span><span>;
    </span><span class="text-codex-syntax-attribute">border-bottom</span><span>: </span><span class="text-codex-syntax-literal">1px solid </span><span class="text-codex-syntax-string">#f1f1f1</span><span>;
}

</span><span class="text-codex-syntax-attribute">.price-card </span><span class="text-codex-syntax-name">p span </span><span>{
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--red</span><span>);
    </span><span class="text-codex-syntax-attribute">font-weight</span><span>: </span><span class="text-codex-syntax-literal">700</span><span>;
    </span><span class="text-codex-syntax-attribute">text-align</span><span>: </span><span class="text-codex-syntax-literal">right</span><span>;
    </span><span class="text-codex-syntax-attribute">white-space</span><span>: </span><span class="text-codex-syntax-literal">nowrap</span><span>;
}

</span><span class="Comment-dh5VVn">/* FOOTER */</span><span>

</span><span class="text-codex-syntax-attribute">.footer </span><span>{
    </span><span class="text-codex-syntax-attribute">background</span><span>: </span><span class="text-codex-syntax-string">#222</span><span>;
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-literal">white</span><span>;
    </span><span class="text-codex-syntax-attribute">text-align</span><span>: </span><span class="text-codex-syntax-literal">center</span><span>;
    </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">45px 15px</span><span>;
    </span><span class="text-codex-syntax-attribute">border-top</span><span>: </span><span class="text-codex-syntax-literal">5px solid </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--gold</span><span>);
}

</span><span class="text-codex-syntax-attribute">.footer </span><span class="text-codex-syntax-name">h2 </span><span>{
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--gold</span><span>);
    </span><span class="text-codex-syntax-attribute">margin-bottom</span><span>: </span><span class="text-codex-syntax-literal">15px</span><span>;
}

</span><span class="text-codex-syntax-attribute">.footer </span><span class="text-codex-syntax-name">p </span><span>{
    </span><span class="text-codex-syntax-attribute">margin</span><span>: </span><span class="text-codex-syntax-literal">7px 0</span><span>;
    </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">15px</span><span>;
}

</span><span class="text-codex-syntax-attribute">.footer .social </span><span>{
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--gold</span><span>);
    </span><span class="text-codex-syntax-attribute">font-weight</span><span>: </span><span class="text-codex-syntax-literal">700</span><span>;
}

</span><span class="text-codex-syntax-attribute">.copyright </span><span>{
    </span><span class="text-codex-syntax-attribute">margin-top</span><span>: </span><span class="text-codex-syntax-literal">20px </span><span class="text-codex-syntax-keyword">!important</span><span>;
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-string">#aaaaaa</span><span>;
    </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">12px </span><span class="text-codex-syntax-keyword">!important</span><span>;
}

</span><span class="Comment-dh5VVn">/* TABLET */</span><span>

</span><span class="text-codex-syntax-keyword">@media </span><span>(</span><span class="text-codex-syntax-attribute">max-width</span><span>: </span><span class="text-codex-syntax-literal">900px</span><span>) {
    </span><span class="text-codex-syntax-attribute">.price-grid </span><span>{
        </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-variable">repeat</span><span>(</span><span class="text-codex-syntax-literal">2</span><span>, </span><span class="text-codex-syntax-variable">minmax</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">1fr</span><span>));
    }
}

</span><span class="Comment-dh5VVn">/* MOBILE */</span><span>

</span><span class="text-codex-syntax-keyword">@media </span><span>(</span><span class="text-codex-syntax-attribute">max-width</span><span>: </span><span class="text-codex-syntax-literal">600px</span><span>) {
    </span><span class="text-codex-syntax-attribute">.header </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">25px 12px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.header </span><span class="text-codex-syntax-name">img </span><span>{
        </span><span class="text-codex-syntax-attribute">max-width</span><span>: </span><span class="text-codex-syntax-literal">350px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.header </span><span class="text-codex-syntax-name">h1 </span><span>{
        </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">25px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.rate-list </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">40px 15px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.rate-list </span><span class="text-codex-syntax-keyword">&gt; </span><span class="text-codex-syntax-name">h2 </span><span>{
        </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">27px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.price-grid </span><span>{
        </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-literal">1fr</span><span>;
        </span><span class="text-codex-syntax-attribute">gap</span><span>: </span><span class="text-codex-syntax-literal">15px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.price-card </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">20px 15px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.price-card </span><span class="text-codex-syntax-name">h3 </span><span>{
        </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">17px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.price-card </span><span class="text-codex-syntax-name">p </span><span>{
        </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">13px</span><span>;
    }
}</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-665198d588c5d67e.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div></div><h3 class="TextBase-qM5iDq Title-mwq_Iy" data-d-text-flow="" data-d-component="title" data-d-size="md" data-d-weight="semibold">3. Folder structure</h3><p class="TextBase-qM5iDq Text-nubxrT" data-d-text-flow="" data-d-component="text">Apne VS Code project folder mein ye 3 files rakho:</p><div data-client-defined-widget="code_block"><div class="CodeBlock-zu1QM3"><div data-code-block="true" data-markdown-copy="code-block" data-theme="dark" class="relative Root-iW7ipz w-full min-w-0 contain-inline-size overflow-clip rounded-(--radius-3xl-base) border border-subtle text-default CodeSurface-UAMd1A Surface-BCuIs1 dark @container" data-search-result-target=""><div data-markdown-copy="exclude" contenteditable="false" class="flex items-center font-sans text-sm select-none ActionBar-KWWAct min-h-12 gap-2 py-1.5 ps-4 pe-1.5 font-medium text-default md:ps-5 sticky z-10 StickyActionBar-RZfVQh"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-665198d588c5d67e.svg#codex-icon-code-light-20" fill="currentColor"></use></svg><div class="min-w-0 flex-1 truncate">Plain text</div><div class="ms-auto flex items-center min-w-0 max-w-full"><div data-code-b