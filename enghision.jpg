</span><span class="Comment-dh5VVn">&lt;!-- ABOUT --&gt;</span><span>
&lt;</span><span class="text-codex-syntax-name">section </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"about" </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"about"</span><span>&gt;

    &lt;</span><span class="text-codex-syntax-name">h2</span><span>&gt;About Sohna Aesthetics&lt;/</span><span class="text-codex-syntax-name">h2</span><span>&gt;

    &lt;</span><span class="text-codex-syntax-name">p</span><span>&gt;
        Welcome to Sohna Aesthetics. We provide information about aesthetic
        and skincare services with a focus on professional consultation
        and individual assessment.
    &lt;/</span><span class="text-codex-syntax-name">p</span><span>&gt;

    &lt;</span><span class="text-codex-syntax-name">h3</span><span>&gt;Professional&lt;/</span><span class="text-codex-syntax-name">h3</span><span>&gt;
    &lt;</span><span class="text-codex-syntax-name">p</span><span>&gt;Atta Ul Rehman&lt;/</span><span class="text-codex-syntax-name">p</span><span>&gt;

&lt;/</span><span class="text-codex-syntax-name">section</span><span>&gt;


