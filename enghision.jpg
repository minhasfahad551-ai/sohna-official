    }

    </span><span class="text-codex-syntax-attribute">.about </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">50px 20px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.footer </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">40px 15px</span><span>;
    }
}</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-665198d588c5d67e.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div></div><h3 class="TextBase-qM5iDq Title-mwq_Iy" data-d-text-flow="" data-d-component="title" data-d-size="md" data-d-weight="semibold"><span data-d-text-flow="word" data-d-stream-word="">3. </span><code class="Code-mbuvRp" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">aesthetics.js</span></code></h3><p class="TextBase-qM5iDq Text-nubxrT" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">Ye </span><span data-d-text-flow="word" data-d-stream-word="">appointment </span><span data-d-text-flow="word" data-d-stream-word="">form </span><span data-d-text-flow="word" data-d-stream-word="">ko </span><span data-d-text-flow="word" data-d-stream-word="">WhatsApp </span><span data-d-text-flow="word" data-d-stream-word="">se </span><span data-d-text-flow="word" data-d-stream-word="">connect </span><span data-d-text-flow="word" data-d-stream-word="">karega. </span><span data-d-text-flow="word" data-d-stream-word="">Request </span><span data-d-text-flow="word" data-d-stream-word="">bhejne </span><span data-d-text-flow="word" data-d-stream-word="">ke </span><span data-d-text-flow="word" data-d-stream-word="">baad </span><span data-d-text-flow="word" data-d-stream-word="">WhatsApp </span><span data-d-text-flow="word" data-d-stream-word="">khulega </span><span data-d-text-flow="word" data-d-stream-word="">aur </span><span data-d-text-flow="word" data-d-stream-word="">customer </span><span data-d-text-flow="word" data-d-stream-word="">khud </span><span data-d-text-flow="word" data-d-stream-word="">Send </span><span data-d-text-flow="word" data-d-stream-word="">press </span><span data-d-text-flow="word" data-d-stream-word="">karega.</span></p><div data-client-defined-widget="code_block"><div class="CodeBlock-zu1QM3"><div data-code-block="true" data-markdown-copy="code-block" data-theme="dark" class="relative Root-iW7ipz w-full min-w-0 contain-inline-size overflow-clip rounded-(--radius-3xl-base) border border-subtle text-default CodeSurface-UAMd1A Surface-BCuIs1 dark @container" data-search-result-target=""><div data-markdown-copy="exclude" contenteditable="false" class="flex items-center font-sans text-sm select-none ActionBar-KWWAct min-h-12 gap-2 py-1.5 ps-4 pe-1.5 font-medium text-default md:ps-5 sticky z-10 StickyActionBar-RZfVQh"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-665198d588c5d67e.svg#codex-icon-code-light-20" fill="currentColor"></use></svg><div class="min-w-0 flex-1 truncate">JavaScript</div><div class="ms-auto flex items-center min-w-0 max-w-full"><div data-code-block-controls="true" role="presentation" class="flex items-center gap-px print:hidden flex-wrap justify-end"><span data-state="closed" class="contents"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0 hover:text-default" aria-label="Disable word wrap" aria-pressed="true"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-665198d588c5d67e.svg#codex-icon-text-wrap-light-20" fill="currentColor"></use></svg></button></span><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Copy code" data-state="closed"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-665198d588c5d67e.svg#codex-icon-square-on-square-light-20" fill="currentColor"></use></svg></button></div></div></div><div class="relative [container-type:inline-size]"><div class="InlineCodePane-EYx4bd w-full overflow-x-hidden"><div class="relative z-0 flex max-w-full Viewer-ALA646" dir="ltr"><div class="chatgpt-code-scrollport flex w-full items-stretch overscroll-x-contain Scrollport-kY3Nlm overflow-x-hidden"><pre class="m-0 flex-1 cursor-text px-4 pb-3 font-mono text-size-code text-default md:px-5 ViewerContent-Cg8AgN pt-0 min-w-0 whitespace-pre-wrap wrap-anywhere"><code><span class="Comment-dh5VVn">// SET MINIMUM DATE TO TODAY</span><span>

</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">dateInput </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"appointmentDate"</span><span>);

</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">today </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-variable">Date</span><span>();
</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">year </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">today</span><span>.</span><span class="text-codex-syntax-variable">getFullYear</span><span>();
</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">month </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">String</span><span>(</span><span class="text-codex-syntax-variable">today</span><span>.</span><span class="text-codex-syntax-variable">getMonth</span><span>() </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-literal">1</span><span>).</span><span class="text-codex-syntax-variable">padStart</span><span>(</span><span class="text-codex-syntax-literal">2</span><span>, </span><span class="text-codex-syntax-string">"0"</span><span>);
</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">day </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">String</span><span>(</span><span class="text-codex-syntax-variable">today</span><span>.</span><span class="text-codex-syntax-variable">getDate</span><span>()).</span><span class="text-codex-syntax-variable">padStart</span><span>(</span><span class="text-codex-syntax-literal">2</span><span>, </span><span class="text-codex-syntax-string">"0"</span><span>);

</span><span class="text-codex-syntax-variable">dateInput</span><span>.</span><span class="text-codex-syntax-attribute">min </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">`</span><span>${</span><span class="text-codex-syntax-variable">year</span><span>}</span><span class="text-codex-syntax-string">-</span><span>${</span><span class="text-codex-syntax-variable">month</span><span>}</span><span class="text-codex-syntax-string">-</span><span>${</span><span class="text-codex-syntax-variable">day</span><span>}</span><span class="text-codex-syntax-string">`</span><span>;


</span><span class="Comment-dh5VVn">// APPOINTMENT CONSULTATION FORM</span><span>

</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">appointmentForm </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"appointmentForm"</span><span>);

</span><span class="text-codex-syntax-variable">appointmentForm</span><span>.</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"submit"</span><span>, </span><span class="text-codex-syntax-keyword">function</span><span>(</span><span class="text-codex-syntax-variable">event</span><span>) {

    </span><span class="text-codex-syntax-variable">event</span><span>.</span><span class="text-codex-syntax-variable">preventDefault</span><span>();

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">name </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"customerName"</span><span>).</span><span class="text-codex-syntax-attribute">value</span><span>.</span><span class="text-codex-syntax-variable">trim</span><span>();
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">phone </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"customerPhone"</span><span>).</span><span class="text-codex-syntax-attribute">value</span><span>.</span><span class="text-codex-syntax-variable">trim</span><span>();
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">date </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"appointmentDate"</span><span>).</span><span class="text-codex-syntax-attribute">value</span><span>;
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">time </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"appointmentTime"</span><span>).</span><span class="text-codex-syntax-attribute">value</span><span>;
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">topic </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"consultationTopic"</span><span>).</span><span class="text-codex-syntax-attribute">value</span><span>.</span><span class="text-codex-syntax-variable">trim</span><span>();
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">consent </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"consultationConsent"</span><span>).</span><span class="text-codex-syntax-attribute">checked</span><span>;

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-string">/^03[0-9]{9}$/</span><span>.</span><span class="text-codex-syntax-variable">test</span><span>(</span><span class="text-codex-syntax-variable">phone</span><span>)) {
        </span><span class="text-codex-syntax-variable">alert</span><span>(</span><span class="text-codex-syntax-string">"Please enter a valid Pakistani mobile number."</span><span>);
        </span><span class="text-codex-syntax-keyword">return</span><span>;
    }

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">consent</span><span>) {
        </span><span class="text-codex-syntax-variable">alert</span><span>(</span><span class="text-codex-syntax-string">"Please confirm the consultation information."</span><span>);
        </span><span class="text-codex-syntax-keyword">return</span><span>;
    }

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">message </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-string">`SOHNA AESTHETICS - CONSULTATION REQUEST</span><span>

</span><span class="text-codex-syntax-string">Name: </span><span>${</span><span class="text-codex-syntax-variable">name</span><span>}
</span><span class="text-codex-syntax-string">Customer Phone: </span><span>${</span><span class="text-codex-syntax-variable">phone</span><span>}

</span><span class="text-codex-syntax-string">Preferred Date: </span><span>${</span><span class="text-codex-syntax-variable">date</span><span>}
</span><span class="text-codex-syntax-string">Preferred Time: </span><span>${</span><span class="text-codex-syntax-variable">time</span><span>}

</span><span class="text-codex-syntax-string">Consultation Query:</span><span>
${</span><span class="text-codex-syntax-variable">topic</span><span>}

</span><span class="text-codex-syntax-string">Professional: Atta Ul Rehman</span><span>

</span><span class="text-codex-syntax-string">This is a consultation request only, not a confirmed treatment booking.`</span><span>;

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">whatsappNumber </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"923158466285"</span><span>;

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">whatsappURL </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-string">"https://wa.me/" </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">whatsappNumber </span><span class="text-codex-syntax-keyword">+</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-string">"?text=" </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">encodeURIComponent</span><span>(</span><span class="text-codex-syntax-variable">message</span><span>);

    </span><span class="text-codex-syntax-variable">window</span><span>.</span><span class="text-codex-syntax-variable">open</span><span>(</span><span class="text-codex-syntax-variable">whatsappURL</span><span>, </span><span class="text-codex-syntax-string">"_blank"</span><span>);

});</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-665198d588c5d67e.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div></div><h3 class="TextBase-qM5iDq Title-mwq_Iy" data-d-text-flow="" data-d-component="title" data-d-size="md" data-d-weight="semibold"><span data-d-text-flow="word" data-d-stream-word="">4. </span><span data-d-text-flow="word" data-d-stream-word="">Logo </span><span data-d-text-flow="word" data-d-stream-word="">file</span></h3><p class="TextBase-qM5iDq Text-nubxrT" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">Tumhari </span><span data-d-text-flow="word" data-d-stream-word="">bheji </span><span data-d-text-flow="word" data-d-stream-word="">hui </span><span data-d-text-flow="word" data-d-stream-word="">image </span><span data-d-text-flow="word" data-d-stream-word="">ko </span><span data-d-text-flow="word" data-d-stream-word="">project </span><span data-d-text-flow="word" data-d-stream-word="">folder </span><span data-d-text-flow="word" data-d-stream-word="">mein </span><span data-d-text-flow="word" data-d-stream-word="">is </span><span data-d-text-flow="word" data-d-stream-word="">naam </span><span data-d-text-flow="word" data-d-stream-word="">se </span><span data-d-text-flow="word" data-d-stream-word="">save </span><span data-d-text-flow="word" data-d-stream-word="">karna:</span></p><p class="TextBase-qM5